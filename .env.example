# Site settings → Environment variables & secrets (ChatGPT Sites). Never commit real values.
# OAuth endpoint /api/printful/mcp (ChatGPT plugins): per-user tokens, encrypted in D1
CONNECTOR_ENCRYPTION_KEY=
PUBLIC_ORIGIN=
OAUTH_REDIRECT_ORIGINS=chatgpt
# API-key endpoint /mcp and stdio CLI
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
MCP_API_KEY=
# Optional
MCP_API_KEYS=
ALLOW_QUERY_KEY=true
ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://claude.ai
# ChatGPT Sites only, never elsewhere:
TRUST_SITES_IDENTITY=false
ALLOWED_EMAILS=
SKU_MAPPING_JSON=
PACKING_SLIP_JSON=
MAX_AUTO_CONFIRM_COST=
DEFAULT_CURRENCY=EUR
DEFAULT_REGION=europe
DEFAULT_VAT_RATE=0.23
DEFAULT_SHIPPING=STANDARD
PRINTFUL_LANGUAGE=
