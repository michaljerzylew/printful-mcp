{
  "name": "@michaljerzylew/printful-mcp",
  "version": "1.2.0",
  "description": "MCP server for Printful: let AI agents price, place and track print-on-demand orders for your own shop. Cloudflare Workers / ChatGPT Sites, 44 tools, Skills (SEP-2640).",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "chatgpt",
    "chatgpt-sites",
    "claude",
    "claude-desktop",
    "cloudflare-workers",
    "cursor",
    "ecommerce",
    "fulfillment",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "npx",
    "pod",
    "print-on-demand",
    "printful",
    "sep-2640",
    "stdio"
  ],
  "license": "MIT",
  "author": "Michał Lew",
  "homepage": "https://github.com/michaljerzylew/printful-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaljerzylew/printful-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/michaljerzylew/printful-mcp/issues"
  },
  "type": "module",
  "bin": {
    "printful-mcp": "bin/printful-mcp.mjs"
  },
  "files": [
    "bin/printful-mcp.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.michaljerzylew/printful-mcp",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "node scripts/build-skills.mjs && vinext dev",
    "build": "node scripts/build-skills.mjs && vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "skills": "node scripts/build-skills.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "node scripts/build-skills.mjs && node scripts/build-cli.mjs && tsc --noEmit -p . && vitest run && node scripts/oauth-runtime-test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "build:cli": "node scripts/build-skills.mjs && node scripts/build-cli.mjs",
    "prepack": "npm run build:cli",
    "db:generate": "drizzle-kit generate",
    "test:oauth-runtime": "node scripts/oauth-runtime-test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "vitest": "^4.1.12",
    "wrangler": "4.92.0"
  }
}
