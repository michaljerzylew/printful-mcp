{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "printful": {
      "type": "streamable-http",
      "url": "https://YOUR-SITE.chatgpt.site/api/printful/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "authorizationUrl": "https://YOUR-SITE.chatgpt.site/api/oauth/authorize",
            "tokenUrl": "https://YOUR-SITE.chatgpt.site/api/oauth/token",
            "registrationUrl": "https://YOUR-SITE.chatgpt.site/api/oauth/register",
            "resource": "https://YOUR-SITE.chatgpt.site/api/printful/mcp",
            "baseScopes": ["printful"]
          }
        }
      }
    }
  }
}
